# Copy to the deployment environment; do not commit real secrets.
NODE_ENV=production
HOST=127.0.0.1
PORT=4173
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_SESSION_TTL_MINUTES=480

# Runtime paths on the server.
MEDIACRAWLER_ROOT=/opt/daily-intelligence/vendor/MediaCrawler
MEDIACRAWLER_PYTHON=/opt/daily-intelligence/vendor/MediaCrawler/.venv/bin/python
MEDIACRAWLER_RUNNER_SCRIPT=/opt/daily-intelligence/scripts/mediacrawler_runner.py
COLLECTION_DATA_PATH=/opt/daily-intelligence/runtime/mediacrawler
TWITTER_CLI_PATH=/usr/local/bin/twitter
# Optional X authentication for the server-side twitter CLI.
# Keep these values only in the server secret manager/environment.
TWITTER_AUTH_TOKEN=
TWITTER_CT0=

# Local services on the same server.
XHS_MCP_URL=http://127.0.0.1:18060/mcp
XHS_MCP_BEARER_TOKEN=
CRAWLER_INGEST_TOKEN=replace-with-a-long-random-value

# Optional remote Agent. Leave empty to use local rules.
OPENAI_BASE_URL=
OPENAI_API_KEY=
